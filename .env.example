# Copy to .env and fill in real values. Never commit .env.

# Public domain. Its DNS A record must point to this server.
DOMAIN=short.example.com

# Base URL used to build shortUrl in API responses.
PUBLIC_BASE_URL=https://short.example.com

# Database password. Use a long random value, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=change-me

# Optional (defaults: shorturl).
# POSTGRES_DB=shorturl
# POSTGRES_USER=shorturl
